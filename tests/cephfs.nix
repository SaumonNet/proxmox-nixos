let
  common = import ./ceph-common.nix { monitors = [ "pve1" "pve2" "pve3" ]; };
in
{
  name = "pve-cephfs";
  imports = [ common.module ];

  defaults = { lib, pkgs, ... }: {
    # Proxmox activates shared storage on every node. Linux 7.0 added support
    # for the 256-bit CephX keys generated by this Ceph release.
    boot.kernelPackages = lib.mkIf (lib.versionOlder pkgs.linuxPackages.kernel.version "7.0")
      pkgs.linuxPackages_7_3;
  };

  nodes.pve2.services.proxmox-ve.ceph.mds = {
    enable = true;
    daemons = [ "pve2" ];
  };

  testScript = common.setupScript + ''
    with subtest("Create CephFS and register it as Proxmox storage"):
        pve2.succeed("pveceph mds create")
        pve1.wait_until_succeeds("ceph fs dump -f json | jq -e 'any(.standbys[]; .name == \"pve2\")'")
        pve1.succeed("pveceph fs create --pg_num 32 --add-storage")

    with subtest("Share a file between two Proxmox nodes"):
        for host in (pve1, pve3):
            host.succeed("pvesm list cephfs")
        path = "/mnt/pve/cephfs/shared-file"
        pve1.succeed(f"printf 'written on pve1' > {path}")
        assert pve3.succeed(f"cat {path}") == "written on pve1"
  '';
}
